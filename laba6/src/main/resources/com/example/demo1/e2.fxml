<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox stylesheets="@style.css"
      prefHeight="600.0" prefWidth="600.0"
      xmlns="http://javafx.com/javafx/8"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.demo1.MainController">

    <children>

        <!-- Верхній блок з трьома кнопками -->
        <HBox alignment="CENTER" spacing="40" prefHeight="80.0">
            <children>
                <Button text="Додати" prefWidth="140.0" prefHeight="40.0" onAction="#onAdd"/>
                <Button text="Редагувати" prefWidth="140.0" prefHeight="40.0" onAction="#onEdit"/>
                <Button text="Видалити" prefWidth="140.0" prefHeight="40.0" onAction="#onDelete"/>
            </children>
            <padding>
                <Insets top="20.0" left="40.0" right="40.0" bottom="10.0"/>
            </padding>
        </HBox>

        <!-- Пошук -->
        <HBox alignment="CENTER_LEFT" spacing="10" prefHeight="70.0">
            <children>
                <TextField fx:id="searchField"
                           promptText="Дані про користувача"
                           HBox.hgrow="ALWAYS"/>
                <Button text="Пошук" prefWidth="120.0" onAction="#onSearch"/>
            </children>
            <padding>
                <Insets left="40.0" right="40.0" bottom="10.0"/>
            </padding>
        </HBox>

        <!-- Таблиця з контактами -->
        <VBox VBox.vgrow="ALWAYS">
            <padding>
                <Insets left="40.0" right="40.0" top="10.0" bottom="10.0"/>
            </padding>
            <children>
                <TableView fx:id="tableView" prefHeight="400.0">
                    <columns>
                        <TableColumn fx:id="nameColumn" text="ПІП" prefWidth="250.0"/>
                        <TableColumn fx:id="phoneColumn" text="Телефон" prefWidth="250.0"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>

        <!-- Нижня панель: лічильник + Other Labs + ВИХІД -->
        <BorderPane prefHeight="70.0">
            <padding>
                <Insets left="20.0" right="20.0" top="10.0" bottom="20.0"/>
            </padding>
            <left>
                <Label fx:id="countLabel" text="Кількість записів: 0" BorderPane.alignment="CENTER_LEFT"/>
            </left>
            <center>
                <Button text="Other Labs" onAction="#onOtherLabs" BorderPane.alignment="CENTER"/>
            </center>
            <right>
                <Button text="ВИХІД" prefWidth="120.0" onAction="#onExit" BorderPane.alignment="CENTER_RIGHT"/>
            </right>
        </BorderPane>

    </children>
</VBox>
