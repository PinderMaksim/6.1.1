<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.demo1.ModalController"
            prefHeight="220.0" prefWidth="400.0"
            stylesheets="@style.css">

    <center>
        <VBox alignment="CENTER" spacing="10.0">
            <children>
                <Label text="Дані контакту"/>
                <TextField fx:id="nameField" promptText="ПІП"/>
                <TextField fx:id="phoneField" promptText="Номер телефону"/>
                <HBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Button text="OK" prefWidth="90.0" onAction="#onOk"/>
                        <Button text="Скасувати" prefWidth="90.0" onAction="#onCancel"/>
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
            </padding>
        </VBox>
    </center>

</BorderPane>
